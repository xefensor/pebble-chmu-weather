{
  "name": "pebble-chmu-weather",
  "version": "1.0.2",
  "description": "ČHMÚ station observations and ALADIN forecasts for Pebble",
  "author": "Xef",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "build:js": "node scripts/build-js.js",
    "build": "python3 scripts/build.py",
    "test": "node --test test/*.test.js && python3 -m unittest discover -s tests && npm run test:store",
    "smoke": "python3 scripts/smoke.py",
    "build:personal": "python3 scripts/build.py --variant personal",
    "smoke:personal": "python3 scripts/smoke.py --variant personal",
    "store:prepare": "python3 scripts/store-kit.py",
    "store:check": "python3 scripts/store-kit.py --check",
    "test:store": "python3 -m unittest discover -s tests -p test_store_kit.py"
  },
  "dependencies": {
    "suncalc": "1.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "pebble": {
    "projectType": "plugin",
    "displayName": "ČHMÚ Weather",
    "uuid": "00866104-6ce5-4ae3-952f-9800f437442c",
    "sdkVersion": "3",
    "configPage": "config.html",
    "usesPermissions": [
      {
        "name": "Location",
        "reason": "To get weather for your current location; saved locations work without GPS",
        "required": false
      },
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "data-provider.chmi.cz"
          ]
        },
        "reason": "To get public ČHMÚ measurements and forecasts",
        "required": true
      },
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "opendata.chmi.cz"
          ]
        },
        "reason": "To check backup public ČHMÚ observations",
        "required": false
      },
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.open-meteo.com"
          ]
        },
        "reason": "To fill optional forecast fields and forecast UV",
        "required": false
      }
    ],
    "plugin": {
      "description": "Unofficial ČHMÚ weather: nearby station temperature, humidity and wind; public ALADIN forecasts. Optional Open-Meteo adds rain probabilities, forecast UV and up to seven local forecast days. Czech coverage.",
      "script": "plugin.js",
      "sources": [
        {
          "category": "weather",
          "items": [
            "location"
          ],
          "supportsMultiple": true,
          "callerPermissions": [
            "Location"
          ],
          "suggestedRefreshIntervalSec": 1800,
          "properties": {
            "name": [
              "shortText"
            ],
            "temperature": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "feels_like": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "high": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "low": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "condition": [
              "shortText",
              "longText",
              "icon",
              "image"
            ],
            "condition_code": [
              "longText"
            ],
            "humidity": [
              "numericValue",
              "shortText"
            ],
            "uv_index": [
              "numericValue",
              "shortText"
            ],
            "precipitation": [
              "numericValue",
              "shortText"
            ],
            "wind_speed": [
              "numericValue",
              "shortText"
            ],
            "wind_direction": [
              "numericValue"
            ],
            "utc_offset": [
              "numericValue"
            ],
            "sunrise": [
              "timestamp"
            ],
            "sunset": [
              "timestamp"
            ],
            "hourly_temperature": [
              "series.numericValue",
              "series.shortText"
            ],
            "hourly_condition": [
              "series.shortText",
              "series.icon",
              "series.image"
            ],
            "hourly_condition_code": [
              "series.longText"
            ],
            "daily_high": [
              "series.numericValue",
              "series.shortText"
            ],
            "daily_low": [
              "series.numericValue",
              "series.shortText"
            ],
            "daily_condition": [
              "series.shortText",
              "series.longText",
              "series.icon",
              "series.image"
            ],
            "daily_condition_code": [
              "series.longText"
            ],
            "daily_precipitation": [
              "series.numericValue",
              "series.shortText"
            ],
            "hourly_precipitation": [
              "series.numericValue",
              "series.shortText"
            ],
            "daily_source": [
              "series.longText"
            ],
            "daily_sunrise": [
              "series.timestamp"
            ],
            "daily_sunset": [
              "series.timestamp"
            ],
            "source": [
              "shortText",
              "longText"
            ],
            "station": [
              "shortText",
              "longText"
            ],
            "observed_at": [
              "timestamp"
            ],
            "forecast_updated_at": [
              "timestamp"
            ],
            "supplemental_updated_at": [
              "timestamp"
            ],
            "supplemental_source": [
              "longText"
            ],
            "feels_like_source": [
              "longText"
            ],
            "is_forecast": [
              "boolean"
            ],
            "observation_age": [
              "numericValue",
              "shortText"
            ],
            "uv_source": [
              "longText"
            ],
            "uv_updated_at": [
              "timestamp"
            ],
            "app_forecast_updated_at": [
              "timestamp"
            ],
            "app_data_fetched_at": [
              "timestamp"
            ],
            "hourly_source": [
              "series.longText"
            ],
            "humidity_source": [
              "longText"
            ],
            "wind_source": [
              "longText"
            ],
            "humidity_observed_at": [
              "timestamp"
            ],
            "wind_observed_at": [
              "timestamp"
            ],
            "forecast_history_hours": [
              "numericValue"
            ],
            "forecast_history_oldest_download": [
              "timestamp"
            ],
            "today_range_complete": [
              "boolean"
            ],
            "daily_coverage": [
              "series.longText"
            ]
          }
        }
      ]
    }
  }
}
